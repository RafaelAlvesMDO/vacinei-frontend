{
  "expo": {
    "name": "Vacinei!?",
    "slug": "vacinei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vacinei",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087F6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087F6B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vacinei!? usa a sua localização apenas para ordenar as UBS por distância. Ela não é salva nem compartilhada."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Vacinei!? usa a câmera para fotografar a sua caderneta de vacinação e ler as doses. A foto não fica salva no aparelho nem no servidor.",
          "photosPermission": "O Vacinei!? usa a foto escolhida da caderneta de vacinação para ler as doses. A foto não fica salva no aparelho nem no servidor.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
