{
  "expo": {
    "name": "Vacinei!?",
    "slug": "vacinei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vacinei",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "br.edu.cesmac.vacinei",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#087F6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087F6B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vacinei!? usa a sua localização apenas para ordenar as UBS por distância. Ela não é salva nem compartilhada."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Vacinei!? usa a câmera para fotografar a sua caderneta de vacinação e ler as doses. A foto não fica salva no aparelho nem no servidor.",
          "photosPermission": "O Vacinei!? usa a foto escolhida da caderneta de vacinação para ler as doses. A foto não fica salva no aparelho nem no servidor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#077A66"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "23955dec-8b1d-4434-8a78-b19e26ce2d03"
      }
    },
    "owner": "rafael_a"
  }
}
